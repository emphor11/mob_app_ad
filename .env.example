# ==============================================================================
# SmartQuote Monorepo Environment Variables Template
# Copy this file or use service-specific .env files in /backend and /mobile
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PROJECT_NAME="SmartQuote API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Connection
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartquote_db"

# Security & Authentication (Argon2 + JWT)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:8081","http://localhost:19006","http://localhost:3000","*"]'

# ------------------------------------------------------------------------------
# Mobile Configuration (mobile/.env)
# ------------------------------------------------------------------------------
# In Expo, variables prefixed with EXPO_PUBLIC_ are embedded into client bundle.
# NEVER place private secrets, database credentials, or JWT secrets in mobile/.env!
#
# For iOS Simulator / Web: http://localhost:8000
# For Android Emulator:    http://10.0.2.2:8000
# For Physical Device:     http://<YOUR_LOCAL_IP>:8000
EXPO_PUBLIC_API_URL="http://localhost:8000"
